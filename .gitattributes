# Large binary assets tracked with Git LFS (configure `git lfs install` before the first push).
# The ReazonSpeech ASR encoder alone is ~148 MB, over GitHub's 100 MB/file limit.
*.onnx   filter=lfs diff=lfs merge=lfs -text
*.tgz    filter=lfs diff=lfs merge=lfs -text
*.aar    filter=lfs diff=lfs merge=lfs -text
*.so     filter=lfs diff=lfs merge=lfs -text
*.task   filter=lfs diff=lfs merge=lfs -text
*.vrm    filter=lfs diff=lfs merge=lfs -text
*.vvm    filter=lfs diff=lfs merge=lfs -text

# Bundled model/data assets must stay byte-for-byte on EVERY platform.
# Without this, a Windows clone (git core.autocrlf=true) rewrites the line endings of the
# plain-text `tokens.txt`, changing its bytes and sha256 so sherpa-onnx cannot load it and the
# app reports "voice models unavailable — tokens.txt". `-text` disables all EOL conversion.
feature/voice/src/main/assets/voice/** -text
feature/avatar/src/main/assets/** -text
