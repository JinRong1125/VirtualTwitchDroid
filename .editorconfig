# Coding style for VirtualTwitchDroid, following the official Kotlin + Android Kotlin style guides.
# Android Studio applies the generic + ij_* keys today; the ktlint_* keys take effect if a
# ktlint/Spotless plugin is added later (they are read from here, not duplicated in build config).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Android Kotlin style + ktlint "standard" ruleset.
ktlint_code_style = android_studio
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_filename = enabled
# Jetpack Compose @Composable functions are intentionally PascalCase — don't flag them.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json,xml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
